# ---- Contracts (copy to contracts/.env, then `source .env`) ----
# Store the deployer key with `cast wallet import deployer --interactive`, never in this file.

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<your-key>
ETHERSCAN_API_KEY=

# Platform admin = the deploying wallet (use a Safe multisig on mainnet)
PLATFORM_ADMIN=
# Optional, comma-separated wallets allowed to create tokens
INITIAL_ISSUERS=

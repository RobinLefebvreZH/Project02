# Apache settings for the static build on OVH (robin-lefebvre.com/erc-3643). Ignored by Vercel.
DirectoryIndex index.html
ErrorDocument 404 /erc-3643/404.html

<IfModule mod_headers.c>
  # Build files have content hashes in their names, so they can be cached for a long time.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
